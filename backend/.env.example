# === Database ===
# Local Docker (development)
DATABASE_URL="postgresql://eduadmin:eduadmin_secret@localhost:5432/eduadmin_bimbel"
# Direct connection (sama untuk local, beda port untuk production)
DATABASE_URL_DIRECT="postgresql://eduadmin:eduadmin_secret@localhost:5432/eduadmin_bimbel"

# For Supabase Cloud (production):
# Transaction pooling (via PgBouncer, port 6543)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres"
# Direct (port 5432)
# DATABASE_URL_DIRECT="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# === Supabase Auth ===
# Local (dari output `supabase start`)
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-local-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-local-supabase-service-role-key"

# For Supabase Cloud:
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_ANON_KEY="[anon-key]"
# SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# === CORS ===
CORS_ORIGIN="http://localhost:3000"

# === Google OAuth ===
# Client ID dari Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="837002929275-something.apps.googleusercontent.com"
# Default role untuk user baru dari Google OAuth (ADMIN / GURU / FINANCE / SISWA)
GOOGLE_DEFAULT_ROLE="GURU"
# Client Secret (opsional untuk Web server flow, tidak dipakai di token verification flow)
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# === JWT (custom, untuk Google OAuth users) ===
JWT_ACCESS_SECRET="change-me-to-a-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"

# === Sentry (opsional) ===
# SENTRY_DSN="https://example@o0.ingest.sentry.io/0"

# === Server ===
PORT=3001
NODE_ENV=development
