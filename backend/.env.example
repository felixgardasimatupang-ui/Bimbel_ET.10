# === Database ===
# Local Supabase (development)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Direct connection for migrations (sama untuk local, beda port untuk production)
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:54322/postgres"

# For Supabase Cloud (production):
# Transaction pooling (via PgBouncer, port 6543)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres"
# Direct (port 5432)
# DATABASE_URL_DIRECT="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# === Supabase Auth ===
# Local (dari output `supabase start`)
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-local-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-local-supabase-service-role-key"

# For Supabase Cloud:
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_ANON_KEY="[anon-key]"
# SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# === CORS ===
CORS_ORIGIN="http://localhost:3000"

# === Sentry (opsional) ===
# SENTRY_DSN="https://example@o0.ingest.sentry.io/0"

# === Server ===
PORT=3001
NODE_ENV=development
