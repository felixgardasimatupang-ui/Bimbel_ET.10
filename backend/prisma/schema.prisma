generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_DIRECT")
  extensions = [pg_trgm, citext]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  GURU
  SISWA
  WALI_MURID
}

enum SppStatus {
  BELUM_BAYAR
  LUNAS
}

enum TransactionType {
  SPP_MASUK
  GAJI_GURU
  OPERASIONAL
  LAIN_LAIN
}

enum TransactionStatus {
  LUNAS
  TERTUNDA
  BATAL
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALFA
}

enum AttendanceMethod {
  QR_SCAN
  LOKASI
  MANUAL
}

enum ScheduleStatus {
  AKAN_DATANG
  SEDANG_BERLANGSUNG
  SELESAI
}

enum MaterialType {
  PDF
  VIDEO
  TUGAS
}

enum NotificationType {
  INFO
  SPP_INFO
  UJIAN_INFO
  JADWAL_INFO
  PENGUMUMAN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  REGISTER
  CHECKIN
  EVALUATE
  SEED
}

enum AuditEntity {
  user
  student
  teacher
  transaction
  material
  notification
  schedule
  quiz
  attendance
}

model User {
  id          String   @id @default(cuid())
  supabaseUid String?  @unique @map("supabase_uid")
  email       String   @unique
  password    String?
  name        String
  role        UserRole @default(ADMIN)
  avatar      String?
  provider    String?  @map("provider")
  providerId  String?  @map("provider_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([active])
  @@index([provider])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Student {
  id              String       @id @default(cuid())
  name            String
  classLevel      String       @map("class_level")
  email           String       @unique
  parentName      String       @map("parent_name")
  parentEmail     String       @map("parent_email")
  sppAmount       Int          @map("spp_amount")
  sppStatus       SppStatus    @default(BELUM_BAYAR) @map("spp_status")
  performanceScore Float       @default(80) @map("performance_score")
  attendanceRate  Float        @default(100) @map("attendance_rate")
  qrCodeData      String       @map("qr_code_data")
  avatar          String?
  locationCheckedIn Boolean    @default(false) @map("location_checked_in")
  checkInTime     String?      @map("check_in_time")
  latitude        Float?
  longitude       Float?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  subjectsScore   SubjectScore[]
  progressHistory ProgressHistory[]
  attendances     Attendance[]
  transactions    Transaction[]

  @@index([name])
  @@index([email])
  @@index([classLevel])
  @@index([sppStatus])
  @@index([active])
  @@index([classLevel, active])
  @@index([sppStatus, active])
  @@index([parentName])
  @@map("students")
}

model SubjectScore {
  id        String @id @default(cuid())
  studentId String @map("student_id")
  name      String
  score     Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("subject_scores")
}

model ProgressHistory {
  id         String @id @default(cuid())
  studentId  String @map("student_id")
  month      String
  score      Float
  attendance Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("progress_history")
}

model Teacher {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  subjects        String[]
  rating          Float    @default(0)
  attendanceRate  Float    @default(100) @map("attendance_rate")
  evaluationScore Float    @default(0) @map("evaluation_score")
  totalClasses    Int      @default(0) @map("total_classes")
  activeStudents  Int      @default(0) @map("active_students")
  avatar          String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  evaluations  Evaluation[]
  schedules    Schedule[]

  @@index([email])
  @@index([active])
  @@index([rating])
  @@index([rating, active])
  @@map("teachers")
}

model Evaluation {
  id           String @id @default(cuid())
  teacherId    String @map("teacher_id")
  date         String
  reviewer     String
  pedagogical  Int
  professional Int
  social       Int
  feedback     String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([date])
  @@map("evaluations")
}

model Schedule {
  id          String         @id @default(cuid())
  teacherId   String         @map("teacher_id")
  classTitle  String         @map("class_title")
  startTime   String         @map("start_time")
  endTime     String         @map("end_time")
  roomCode    String         @map("room_code")
  status      ScheduleStatus @default(AKAN_DATANG)
  teacherName String         @map("teacher_name")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@index([startTime])
  @@index([status, startTime])
  @@map("schedules")
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String           @map("student_id")
  date        DateTime         @default(now())
  status      AttendanceStatus @default(HADIR)
  method      AttendanceMethod @default(QR_SCAN)
  checkInTime String?          @map("check_in_time")
  latitude    Float?
  longitude   Float?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
  @@index([studentId, date])
  @@index([status])
  @@map("attendances")
}

model Transaction {
  id        String            @id @default(cuid())
  studentId String            @map("student_id")
  amount    Int
  type      TransactionType
  date      DateTime          @default(now())
  status    TransactionStatus @default(LUNAS)
  notes     String?
  payeeName String            @map("payee_name")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([date])
  @@index([status])
  @@index([studentId, type, date])
  @@map("transactions")
}

model Material {
  id             String       @id @default(cuid())
  title          String
  subject        String
  targetLevel    String       @map("target_level")
  type           MaterialType @default(PDF)
  url            String       @default("#")
  uploadDate     DateTime     @default(now()) @map("upload_date")
  downloadsCount Int          @default(0) @map("downloads_count")
  author         String
  isLocked       Boolean      @default(false) @map("is_locked")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([subject])
  @@index([active])
  @@index([isLocked])
  @@index([subject, active])
  @@index([isLocked, active])
  @@index([uploadDate])
  @@index([type])
  @@map("materials")
}

model QuizQuestion {
  id           String @id @default(cuid())
  text         String
  options      String[]
  correctIndex Int    @map("correct_index")
  quizId       String @map("quiz_id")

  quiz InteractiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model InteractiveQuiz {
  id          String   @id @default(cuid())
  title       String
  subject     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  questions QuizQuestion[]

  @@map("interactive_quizzes")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String?          @map("user_id")
  title      String
  message    String
  type       NotificationType @default(INFO)
  targetRole String           @map("target_role")
  read       Boolean          @default(false)
  timestamp  DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetRole])
  @@index([read])
  @@index([timestamp])
  @@index([type])
  @@index([targetRole, read])
  @@index([userId, read])
  @@map("notifications")
}

model AuditLog {
  id        String       @id @default(cuid())
  userId    String?      @map("user_id")
  action    AuditAction
  entity    AuditEntity
  entityId  String?      @map("entity_id")
  details   String?
  ip        String?
  createdAt DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action, entity, createdAt])
  @@map("audit_logs")
}

model QrSession {
  id           String   @id @default(cuid())
  code         String   @unique
  courseName   String   @map("course_name")
  validUntil   DateTime @map("valid_until")
  hqLatitude   Float    @default(-6.2088) @map("hq_latitude")
  hqLongitude  Float    @default(106.8456) @map("hq_longitude")
  maxDistance  Float    @default(20.0) @map("max_distance")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([active])
  @@index([validUntil])
  @@map("qr_sessions")
}
