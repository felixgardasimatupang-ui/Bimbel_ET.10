# EduAdmin Bimbel — Frontend Environment
# Copy file ini ke .env untuk development

# API Backend URL (default: http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api

# Sentry DSN for error tracking (opsional)
# VITE_SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# GPS default coordinates (fallback ketika browser geolocation gagal)
# VITE_GPS_LAT=-6.2088
# VITE_GPS_LON=106.8456
