{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/max-free",
  "small_model": "9router/light-free",
  "mcp": {
    "ask-skill-kit": {
      "type": "local",
      "command": ["ask", "mcp", "serve"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  }
}
