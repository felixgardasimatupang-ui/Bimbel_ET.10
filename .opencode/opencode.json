{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ask-skill-kit": {
      "type": "local",
      "command": ["ask", "mcp", "serve"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "agent": {
    "explore": {
      "model": "9router/qwen3-coder"
    },
    "general": {
      "model": "9router/deepseek-agentic"
    }
  }
}
